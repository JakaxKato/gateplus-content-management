# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env (sudah masuk .gitignore).

# Port server API
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Koneksi MongoDB.
# Opsi 1 (lokal, via docker compose): mongodb://127.0.0.1:27017/gateplus
# Opsi 2 (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster>/gateplus
MONGODB_URI=mongodb://127.0.0.1:27017/gateplus

# Secret untuk menandatangani JWT. Ganti dengan string acak yang panjang.
JWT_SECRET=ubah-secret-ini-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d

# Origin frontend yang diizinkan mengakses API (CORS)
CLIENT_ORIGIN=http://localhost:5173
